# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/problemfix?schema=public"

# Auth
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Social auth (fill in when wiring providers)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# SMS / phone auth (e.g. Twilio)
SMS_PROVIDER_API_KEY=

# Storage (photos/videos) - e.g. S3 / GCS bucket
STORAGE_BUCKET_NAME=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Agent AI service (Google ADK)
AGENT_AI_BASE_URL=http://localhost:8001
AGENT_AI_API_KEY=
