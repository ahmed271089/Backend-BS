{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2021",
    "lib": ["ES2021"],

    "moduleResolution": "node",
    "types": ["node"],

    "rootDir": "./src",
    "outDir": "./dist",

    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "exclude": ["prisma", "dist", "node_modules"]
}